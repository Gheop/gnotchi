#!/usr/bin/env python3
# Rejoue un .jsonl d'événements dans le socket gnotchi.
import json, os, socket, sys, time


def main():
    if len(sys.argv) < 2:
        print("usage: gnotchi-sim <fixture.jsonl> [delay_s]"); sys.exit(2)
    delay = float(sys.argv[2]) if len(sys.argv) > 2 else 1.0
    rt = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    path = os.path.join(rt, "gnotchi.sock")
    with open(sys.argv[1]) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            msg = json.loads(line)
            msg.setdefault("v", 1)
            msg.setdefault("ts", int(time.time()))
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.connect(path)
                s.sendall((json.dumps(msg) + "\n").encode())
            print("envoyé", msg["event"], msg["session_id"])
            time.sleep(delay)


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception as e:
        sys.exit(f"gnotchi-sim: {e}")
