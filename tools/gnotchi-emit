#!/usr/bin/env python3
# Hook Claude Code -> socket Unix de gnotchi.
# Ne bloque jamais, ne sort jamais en erreur, ne pollue jamais stdout/stderr.
import json, os, re, socket, sys, time

_RULES = [
    ("sobbing", r"(putain|merde|encore cass|toujours pas|tjrs pas|wtf|fait chier)"),
    ("elated",  r"(parfait|génial|genial|excellent|incroyable|ça marche enfin|ca marche enfin|exactement)"),
    ("sad",     r"(bug|cass[ée]|erreur|échec|echec|marche pas|plante|broken|fail)"),
    ("happy",   r"(merci|super|nickel|bien joué|bien joue|top|cool|ça marche|ca marche)"),
]
_MOODS_RES = [
    (mood, re.compile(r"(?<![a-zA-Zà-ÿ])" + pat + r"(?![a-zA-Zà-ÿ])", re.IGNORECASE))
    for mood, pat in _RULES
]


def classify(text):
    t = text or ""
    for mood, rx in _MOODS_RES:
        if rx.search(t):
            return mood
    return "neutral"


def is_tool_error(tr):
    if isinstance(tr, dict):
        if tr.get("error"):
            return True
        if tr.get("is_error") is True:
            return True
        if tr.get("status") == "error":
            return True
    return False


# Terminaux émulateurs reconnus. La détection remonte la chaîne des PPID
# jusqu'à matcher l'un de ces noms. Limite 20 itérations contre les boucles.
_TERMINALS = (
    "gnome-terminal-", "gnome-terminal-server", "terminator", "tilix",
    "xterm", "xfce4-terminal", "alacritty", "kitty", "foot",
    "wezterm", "wezterm-gui", "konsole", "urxvt", "rxvt",
    "ptyxis", "ghostty", "st",
)


def detect_terminal_pid():
    """Retourne le PID du terminal ancêtre, ou None si non trouvé."""
    try:
        pid = os.getppid()
        for _ in range(20):
            with open(f"/proc/{pid}/comm") as f:
                comm = f.read().strip()
            if any(comm == t or comm.startswith(t) for t in _TERMINALS):
                return pid
            with open(f"/proc/{pid}/stat") as f:
                content = f.read()
            # Format: "pid (comm) state ppid ..." ; comm peut contenir des
            # parenthèses, on coupe au dernier ')' pour avoir le reste.
            after = content.rsplit(")", 1)[1].split()
            ppid = int(after[1])
            if ppid <= 1:
                return None
            pid = ppid
    except Exception:
        return None
    return None


def reaction(event, payload):
    if event == "Stop":
        return "happy"
    if event == "PostToolUse" and is_tool_error(payload.get("tool_response")):
        return "sad"
    return None


def runtime_dir():
    return os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"


def emotion_mode():
    try:
        with open(os.path.join(runtime_dir(), "gnotchi.conf")) as f:
            return json.load(f).get("emotion_mode", "local")
    except Exception:
        return "local"


def send(msg):
    path = os.path.join(runtime_dir(), "gnotchi.sock")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(0.5)
    try:
        s.connect(path)
        s.sendall((json.dumps(msg) + "\n").encode("utf-8"))
    finally:
        s.close()


def headless_emotion(session_id, prompt):
    # Enfant détaché : claude -p, puis second message Emotion.
    if os.fork() != 0:
        return
    os.setsid()
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    os.close(devnull)
    try:
        import subprocess
        q = ("Classify the emotional tone of this user message as exactly one of: "
             "elated, happy, neutral, sad, sobbing. Output only the word. "
             f"Message: <<< {prompt[:2000]} >>>")
        child_env = {**os.environ, "GNOTCHI_HEADLESS": "1"}
        out = subprocess.run(["claude", "-p", q, "--output-format", "json"],
                              capture_output=True, text=True, timeout=20,
                              env=child_env)
        word = None
        try:
            word = json.loads(out.stdout).get("result", "").strip().lower()
        except Exception:
            word = out.stdout.strip().lower()
        if word in ("elated", "happy", "neutral", "sad", "sobbing"):
            send({"v": 1, "event": "Emotion", "session_id": session_id,
                  "ts": int(time.time()), "data": {"emotion": word, "source": "headless"}})
    except Exception:
        pass
    os._exit(0)


def main():
    try:
        # Garde de réentrance : le claude -p de classification (mode
        # local-headless) hérite des hooks gnotchi globaux. Sans ce garde,
        # son propre UserPromptSubmit relance gnotchi-emit -> nouveau
        # claude -p -> récursion non bornée (fork bomb). On ne sort rien
        # et on ne récurse pas pour cette session interne.
        if os.environ.get("GNOTCHI_HEADLESS"):
            return
        event = sys.argv[1] if len(sys.argv) > 1 else ""
        raw = sys.stdin.read()
        try:
            payload = json.loads(raw) if raw.strip() else {}
        except Exception:
            payload = {}
        sid = payload.get("session_id")
        if not isinstance(sid, str) or not sid:
            return
        data = {}
        if isinstance(payload.get("tool_name"), str):
            data["tool_name"] = payload["tool_name"]
        mode = emotion_mode()
        prompt = payload.get("prompt") or ""
        if event == "UserPromptSubmit" and mode != "off":
            data["emotion"] = classify(prompt)
        if event == "SessionStart":
            tpid = detect_terminal_pid()
            if tpid:
                data["terminal_pid"] = tpid
        if event == "PostToolUse" and is_tool_error(payload.get("tool_response")):
            data["is_error"] = True
        msg = {"v": 1, "event": event, "session_id": sid,
               "cwd": payload.get("cwd") or "", "ts": int(time.time()), "data": data}
        try:
            send(msg)
        except Exception:
            pass
        if mode != "off":
            r = reaction(event, payload)
            if r:
                try:
                    send({"v": 1, "event": "Emotion", "session_id": sid,
                          "ts": int(time.time()),
                          "data": {"emotion": r, "source": "reaction"}})
                except Exception:
                    pass
        if event == "UserPromptSubmit" and mode == "local-headless" and prompt:
            try:
                headless_emotion(sid, prompt)
            except Exception:
                pass
    except Exception:
        pass
    finally:
        sys.exit(0)


if __name__ == "__main__":
    main()
